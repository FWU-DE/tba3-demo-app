{
  "name": "tba3-showcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TBA3 — Demoanwendung, Komponentenbibliothek und Rückmeldungsbeispiele unter einem Dach",
  "workspaces": [
    "apps/demo",
    "apps/katalog",
    "packages/bausteine"
  ],
  "scripts": {
    "dev": "npm run dev -w @tba3/demo",
    "dev:demo": "npm run dev -w @tba3/demo",
    "dev:katalog": "npm run dev -w @tba3/katalog",
    "mock": "node tools/mock-server.mjs",
    "build": "npm run build --workspaces --if-present && node tools/build-site.mjs",
    "preview": "node tools/serve-site.mjs",
    "lint": "npm run lint -w @tba3/demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:bericht": "playwright show-report e2e/.bericht",
    "fixtures:update": "node tools/fetch-fixtures.mjs",
    "docs:update": "node tools/update-docs.mjs",
    "docs:bilder": "node tools/dokumentbilder.mjs",
    "konsortium:doc": "node tools/konsortium-dokument.mjs",
    "spec:update": "node tools/update-spec.mjs",
    "material-spec:update": "node tools/build-material-spec.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1",
    "marked": "^18.0.13",
    "swagger-ui-dist": "^5.32.15",
    "vitest": "^5.0.0"
  }
}
