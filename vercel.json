{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/groups/:path*",
      "destination": "/api/groups/:path*"
    },
    {
      "source": "/schools/:path*",
      "destination": "/api/schools/:path*"
    },
    {
      "source": "/states/:path*",
      "destination": "/api/states/:path*"
    },
    {
      "source": "/tba3-api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/demo/:path*",
      "destination": "/demo/index.html"
    },
    {
      "source": "/katalog/:path*",
      "destination": "/katalog/index.html"
    }
  ]
}
